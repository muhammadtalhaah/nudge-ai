# =============================================================================
#  Server configuration — copy to server/.env and fill in.
#  server/.env is gitignored; never commit real secrets.
# =============================================================================

# ------------------------------------------------------------------ runtime --
NODE_ENV=development
PORT=4000
# Comma-separated origins allowed to call the API with credentials.
# In production the client is served by this same process, so this is only needed
# for the Vite dev server.
CORS_ORIGINS=http://localhost:5173

# ----------------------------------------------------------------- database --
# Any PostgreSQL 14+ instance. Requires the pgcrypto and btree_gist extensions,
# both of which ship with a standard install.
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/nudge_ai_dev
# Set to true for managed Postgres that requires TLS (Neon, Supabase, Railway).
DATABASE_SSL=false
# Pool ceiling. Keep well under the server's max_connections.
DATABASE_POOL_MAX=10
# Tenant that self-signups join. The schema is multi-tenant but there is no tenant
# picker in the UI, so signup needs one designated business.
DEFAULT_BUSINESS_SLUG=northside-health

# --------------------------------------------------------------------- auth --
# Generate each with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# The app refuses to boot if either is missing or shorter than 32 characters.
JWT_ACCESS_SECRET=replace-me-with-a-long-random-string
JWT_REFRESH_SECRET=replace-me-with-a-different-long-random-string
# Short-lived, held in memory by the client only.
JWT_ACCESS_TTL=15m
# Long-lived, delivered as an httpOnly cookie and rotated on every use.
REFRESH_TTL_DAYS=30
# bcrypt work factor. 12 is a reasonable desktop/CI balance.
BCRYPT_ROUNDS=12

# ----------------------------------------------------------------------- AI --
# 'mistral' calls the real API; 'stub' uses the deterministic offline provider.
# Leave unset and the server picks mistral when a key is present, stub otherwise —
# so the app always runs, with or without credentials.
AI_PROVIDER=
# Free key from https://console.mistral.ai
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
# Abort a model call after this long and fall back to the structured form.
AI_TIMEOUT_MS=15000
# Cap on prior turns replayed to the model.
AI_HISTORY_TURNS=10

# ------------------------------------------------------------ rate limiting --
RATE_LIMIT_WINDOW_MS=60000
# Requests per window, per IP, across the whole API.
RATE_LIMIT_MAX=120
# Tighter budget for signup/login — credential stuffing costs nothing to attempt.
AUTH_RATE_LIMIT_MAX=10
# Tightest of all: every chat message may cost a model call.
CHAT_RATE_LIMIT_MAX=20

# ------------------------------------------------------------------ logging --
# fatal | error | warn | info | debug | trace
LOG_LEVEL=info
# Human-readable output in dev; leave false in production for JSON logs.
LOG_PRETTY=true
